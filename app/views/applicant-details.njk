{% extends "layout.njk" %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageTitleContent %}
  {% if errorList and errorList.length > 0 %}Error: {% endif %}Applicant and business details
{% endblock %}

{% block beforeContent %}
  <a class="govuk-back-link" href="/">Back</a>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% include "partials/error-summary.njk" %}

      <h1 class="govuk-heading-xl">Applicant and business details</h1>

      <p class="govuk-body">
        Tell us who is applying and which business or holding this
        application is for. This is a fictional demo -- do not enter any
        real personal details.
      </p>

      <form method="post" action="/applicant-details" novalidate>

        {{ govukInput({
          label: {
            text: "Full name"
          },
          id: "fullName",
          name: "fullName",
          value: values.fullName,
          autocomplete: "name",
          errorMessage: errorMap.fullName
        }) }}

        {{ govukInput({
          label: {
            text: "Business or holding name"
          },
          id: "businessName",
          name: "businessName",
          value: values.businessName,
          autocomplete: "organization",
          errorMessage: errorMap.businessName
        }) }}

        {{ govukInput({
          label: {
            text: "Email address"
          },
          hint: {
            text: "We'll only use this to contact you about this demo application."
          },
          id: "emailAddress",
          name: "emailAddress",
          type: "email",
          value: values.emailAddress,
          autocomplete: "email",
          spellcheck: false,
          errorMessage: errorMap.emailAddress
        }) }}

        {{ govukInput({
          label: {
            text: "Telephone number"
          },
          id: "telephoneNumber",
          name: "telephoneNumber",
          type: "tel",
          value: values.telephoneNumber,
          autocomplete: "tel",
          errorMessage: errorMap.telephoneNumber
        }) }}

        {{ govukButton({
          text: "Continue"
        }) }}

      </form>

      <p class="govuk-body govuk-!-margin-top-6">
        DEMO -- not a live service. Not affiliated with, endorsed by, or
        representative of Defra or HM Government. Any details you enter
        here are fictional/mock data and are never stored or sent anywhere.
      </p>

    </div>
  </div>
{% endblock %}